# 복사해서 .env.local로 쓴다. 값이 없으면 피드는 샘플 데이터로 동작한다.

# Supabase 프로젝트 (Settings > API)
SUPABASE_URL=
# 읽기 전용 조회용 (anon)
SUPABASE_ANON_KEY=
# 수집기의 쓰기 권한. 서버 전용이며 절대 클라이언트에 노출하지 않는다
SUPABASE_SERVICE_ROLE_KEY=

# 수집 엔드포인트 /api/cron/[source] 호출 검증용 비밀 값 (임의의 긴 문자열)
CRON_SECRET=

# 외부 API 인증키. 각 공식 페이지에서 신청한 뒤 넣는다
WORK24_API_KEY=
SARAMIN_API_KEY=

# 카카오 (지도 보기). developers.kakao.com에서 앱을 만들어 발급한다. 둘 다 비우면 지도 보기가 숨겨지고 위치도 채우지 않는다
# 지도용 JavaScript 키. 화면에 그대로 노출되는 값이라 앱 > 플랫폼 > Web에 사이트 주소(https://boyuk.vercel.app, 개발 중에는 http://localhost:3000)를 등록해 보호한다
NEXT_PUBLIC_KAKAO_MAP_KEY=
# 어린이집 위치 검색용 REST API 키. 서버 전용이며 절대 클라이언트에 노출하지 않는다
KAKAO_REST_API_KEY=
